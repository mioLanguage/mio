@if !STRING
macro STRING;
extern *char strcpy(dst: *char,src: *char);
extern *char strncpy(dst: *char,src: *char,n: u64);
extern u64 strlen(s: *char);
extern i32 strcmp(a: *char,b: *char);
extern i32 strncmp(a: *char,b: *char,n: u64);
extern *char strcat(dst: *char,src: *char);
extern *char strncat(dst: *char,src: *char,n: u64);
extern *char strchr(s: *char,c: i32);
extern *char strrchr(s: *char,c: i32);
extern *char strstr(haystack: *char,needle: *char);
extern *char strdup(s: *char);
extern i32 memcmp(a: *char,b: *char,n: u64);
extern *char memcpy(dst: *char,src: *char,n: u64);
extern *char memmove(dst: *char,src: *char,n: u64);
extern *char memset(dst: *char,c: i32,n: u64);
@end