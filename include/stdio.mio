@if !STDIO
macro STDIO;
extern i32 printf(fmt: char*, ...);
extern i32 sprintf(buf: char*, fmt: char*, ...);
extern i32 fprintf(stream: char*, fmt: char*, ...);
extern i32 puts(s: char*);
extern i32 putchar(c: i32);
extern i32 getchar();
extern char* gets(buf: char*);
extern char* fgets(buf: char*, size: i32, stream: char*);
extern i32 scanf(fmt: char*, ...);
extern i32 sscanf(buf: char*, fmt: char*, ...);
extern i32 fscanf(stream: char*, fmt: char*, ...);
extern i32 snprintf(buf: char*, size: u64, fmt: char*, ...);
extern i32 rename(oldname: char*, newname: char*);
extern i32 remove(filename: char*);
extern i32 fclose(stream: char*);
extern i32 fflush(stream: char*);
extern char* tmpfile();
extern char* tmpnam(buf: char*);
extern i32 fseek(stream: char*, offset: i64, origin: i32);
extern i64 ftell(stream: char*);
extern void rewind(stream: char*);
extern i32 fgetpos(stream: char*, pos: char*);
extern i32 fsetpos(stream: char*, pos: char*);
extern i32 feof(stream: char*);
extern i32 ferror(stream: char*);
extern void clearerr(stream: char*);
extern i32 fputc(c: i32, stream: char*);
extern i32 fgetc(stream: char*);
extern i32 ungetc(c: i32, stream: char*);
extern u64 fread(ptr: char*, size: u64, count: u64, stream: char*);
extern u64 fwrite(ptr: char*, size: u64, count: u64, stream: char*);
extern char* fopen(filename: char*, mode: char*);
extern char* freopen(filename: char*, mode: char*, stream: char*);
extern void setbuf(stream: char*, buf: char*);
extern i32 setvbuf(stream: char*, buf: char*, mode: i32, size: u64);
extern void perror(s: char*);
@end