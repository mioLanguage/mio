@if !STL
@macro STL
import "std";

namespace stl {
	# ============================================================
	# pair
	# ============================================================
	template$T:typename,U:typename$
	class pair {
	public:
		pair() {}
		pair(f: T,s: U) {
			this.first=f;
			this.second=s;
		}
		i32 operator==(other: pair) {
			if(this.first == other.first && this.second == other.second) {
				return 1;
			}
			return 0;
		}
		i32 operator!=(other: pair) {
			return !(*this == other);
		}
		i32 operator<(other: pair) {
			if(this.first < other.first) {
				return 1;
			}
			if(this.first == other.first && this.second < other.second) {
				return 1;
			}
			return 0;
		}
		first: T;
		second: U;
	};

	# ============================================================
	# function objects (functors)
	# ============================================================
	template$T:typename$
	class less {
	public:
		i32 operator()(a: T,b: T) {
			if(a < b) {
				return 1;
			}
			return 0;
		}
	};
	template$T:typename$
	class greater {
	public:
		i32 operator()(a: T,b: T) {
			if(a > b) {
				return 1;
			}
			return 0;
		}
	};
	template$T:typename$
	class equal_to {
	public:
		i32 operator()(a: T,b: T) {
			if(a == b) {
				return 1;
			}
			return 0;
		}
	};
	template$T:typename$
	class not_equal_to {
	public:
		i32 operator()(a: T,b: T) {
			if(a != b) {
				return 1;
			}
			return 0;
		}
	};
	template$T:typename$
	class plus {
	public:
		T operator()(a: T,b: T) {
			return a+b;
		}
	};
	template$T:typename$
	class minus {
	public:
		T operator()(a: T,b: T) {
			return a-b;
		}
	};
	template$T:typename$
	class multiplies {
	public:
		T operator()(a: T,b: T) {
			return a*b;
		}
	};
	template$T:typename$
	class divides {
	public:
		T operator()(a: T,b: T) {
			return a/b;
		}
	};
	template$T:typename$
	class modulus {
	public:
		T operator()(a: T,b: T) {
			return a % b;
		}
	};
	template$T:typename$
	class negate {
	public:
		T operator()(a: T) {
			return -a;
		}
	};

	# ============================================================
	# hash function (FNV-1a)
	# ============================================================
	u64 hash(data: *char,len: u64) {
		var h: u64=14695981039346656037;
		var i: u64=0;
		for(i=0; i < len; i=i+1) {
			h=h ^ u64(data[i]);
			h=h * 1099511628211;
		}
		return h;
	}

	# ============================================================
	# HashSet (hash-based set)
	# ============================================================
	template$T:typename$
	class HashSet {
	public:
		HashSet() {
			var i: u64=0;
			this.bucket_count=16;
			this.element_count=0;
			this.buckets=malloc(this.bucket_count * sizeof(*Node));
			for(i=0; i < this.bucket_count; i=i+1) {
				var null_ptr: *Node=0;
				memcpy(this.buckets+i * sizeof(*Node),&null_ptr,sizeof(*Node));
			}
		}
		~HashSet() {
			var b: *char=this.buckets;
			this.clear();
			if(b != 0) {
				free(b);
			}
		}
		void insert(val: T) {
			var h: u64=stl::hash(val);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			for(; cur != 0; cur=cur.next) {
				if(cur.value == val) {
					return;
				}
			}
			var node: *Node=*Node(malloc(sizeof(Node)));
			if(node != 0) {
				node.value=val;
				memcpy(&node.next,this.buckets+idx * sizeof(*Node),sizeof(*Node));
				memcpy(this.buckets+idx * sizeof(*Node),&node,sizeof(*Node));
				this.element_count=this.element_count+1;
			}
			if(this.element_count > this.bucket_count * 3 / 4) {
				this.rehash(this.bucket_count * 2);
			}
		}
		i32 contains(val: T) {
			var h: u64=stl::hash(val);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			for(; cur != 0; cur=cur.next) {
				if(cur.value == val) {
					return 1;
				}
			}
			return 0;
		}
		void remove(val: T) {
			var h: u64=stl::hash(val);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			var prev: *Node=0;
			for(; cur != 0; ) {
				if(cur.value == val) {
					if(prev == 0) {
						memcpy(this.buckets+idx * sizeof(*Node),&cur.next,sizeof(*Node));
					} else {
						memcpy(&prev.next,&cur.next,sizeof(*Node));
					}
					free(cur);
					this.element_count=this.element_count-1;
					return;
				}
				prev=cur;
				cur=cur.next;
			}
		}
		u64 size() {
			return this.element_count;
		}
		i32 empty() {
			if(this.element_count == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			var i: u64=0;
			for(i=0; i < this.bucket_count; i=i+1) {
				var cur: *Node;
				memcpy(&cur,this.buckets+i * sizeof(*Node),sizeof(*Node));
				for(; cur != 0; ) {
					var next: *Node=cur.next;
					free(cur);
					cur=next;
				}
				var null_ptr: *Node=0;
				memcpy(this.buckets+i * sizeof(*Node),&null_ptr,sizeof(*Node));
			}
			this.element_count=0;
		}
	private:
		class Node {
		public:
			value: T;
			next: *Node;
		};
		buckets: *char;
		bucket_count: u64;
		element_count: u64;

		void rehash(new_bucket_count: u64) {
			var new_buckets: *char=malloc(new_bucket_count * sizeof(*Node));
			if(new_buckets == 0) {
				return;
			}
			var i: u64=0;
			for(i=0; i < new_bucket_count; i=i+1) {
				var null_ptr: *Node=0;
				memcpy(new_buckets+i * sizeof(*Node),&null_ptr,sizeof(*Node));
			}
			for(i=0; i < this.bucket_count; i=i+1) {
				var cur: *Node;
				memcpy(&cur,this.buckets+i * sizeof(*Node),sizeof(*Node));
				for(; cur != 0; ) {
					var next: *Node=cur.next;
					var h: u64=stl::hash(cur.value);
					var new_idx: u64=h % new_bucket_count;
					memcpy(&cur.next,new_buckets+new_idx * sizeof(*Node),sizeof(*Node));
					memcpy(new_buckets+new_idx * sizeof(*Node),&cur,sizeof(*Node));
					cur=next;
				}
			}
			free(this.buckets);
			this.buckets=new_buckets;
			this.bucket_count=new_bucket_count;
		}
	};

	# ============================================================
	# HashMap (hash-based map)
	# ============================================================
	template$K:typename,V:typename$
	class HashMap {
	public:
		HashMap() {
			var i: u64=0;
			this.bucket_count=16;
			this.element_count=0;
			this.buckets=malloc(this.bucket_count * sizeof(*Node));
			for(i=0; i < this.bucket_count; i=i+1) {
				var null_ptr: *Node=0;
				memcpy(this.buckets+i * sizeof(*Node),&null_ptr,sizeof(*Node));
			}
		}
		~HashMap() {
			var b: *char=this.buckets;
			this.clear();
			if(b != 0) {
				free(b);
			}
		}
		void insert(key: K,val: V) {
			var h: u64=stl::hash(key);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			for(; cur != 0; cur=cur.next) {
				if(cur.key == key) {
					cur.value=val;
					return;
				}
			}
			var node: *Node=*Node(malloc(sizeof(Node)));
			if(node != 0) {
				node.key=key;
				node.value=val;
				memcpy(&node.next,this.buckets+idx * sizeof(*Node),sizeof(*Node));
				memcpy(this.buckets+idx * sizeof(*Node),&node,sizeof(*Node));
				this.element_count=this.element_count+1;
			}
			if(this.element_count > this.bucket_count * 3 / 4) {
				this.rehash(this.bucket_count * 2);
			}
		}
		i32 contains(key: K) {
			var h: u64=stl::hash(key);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			for(; cur != 0; cur=cur.next) {
				if(cur.key == key) {
					return 1;
				}
			}
			return 0;
		}
		V get(key: K) {
			var result: V;
			var h: u64=stl::hash(key);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			for(; cur != 0; cur=cur.next) {
				if(cur.key == key) {
					return cur.value;
				}
			}
			return result;
		}
		V get_or(key: K,default_val: V) {
			var h: u64=stl::hash(key);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			for(; cur != 0; cur=cur.next) {
				if(cur.key == key) {
					return cur.value;
				}
			}
			return default_val;
		}
		V operator[](key: K) {
			return this.get(key);
		}
		void remove(key: K) {
			var h: u64=stl::hash(key);
			var idx: u64=h % this.bucket_count;
			var cur: *Node;
			memcpy(&cur,this.buckets+idx * sizeof(*Node),sizeof(*Node));
			var prev: *Node=0;
			for(; cur != 0; ) {
				if(cur.key == key) {
					if(prev == 0) {
						memcpy(this.buckets+idx * sizeof(*Node),&cur.next,sizeof(*Node));
					} else {
						memcpy(&prev.next,&cur.next,sizeof(*Node));
					}
					free(cur);
					this.element_count=this.element_count-1;
					return;
				}
				prev=cur;
				cur=cur.next;
			}
		}
		u64 size() {
			return this.element_count;
		}
		i32 empty() {
			if(this.element_count == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			var i: u64=0;
			for(i=0; i < this.bucket_count; i=i+1) {
				var cur: *Node;
				memcpy(&cur,this.buckets+i * sizeof(*Node),sizeof(*Node));
				for(; cur != 0; ) {
					var next: *Node=cur.next;
					free(cur);
					cur=next;
				}
				var null_ptr: *Node=0;
				memcpy(this.buckets+i * sizeof(*Node),&null_ptr,sizeof(*Node));
			}
			this.element_count=0;
		}
	private:
		class Node {
		public:
			key: K;
			value: V;
			next: *Node;
		};
		buckets: *char;
		bucket_count: u64;
		element_count: u64;

		void rehash(new_bucket_count: u64) {
			var new_buckets: *char=malloc(new_bucket_count * sizeof(*Node));
			if(new_buckets == 0) {
				return;
			}
			var i: u64=0;
			for(i=0; i < new_bucket_count; i=i+1) {
				var null_ptr: *Node=0;
				memcpy(new_buckets+i * sizeof(*Node),&null_ptr,sizeof(*Node));
			}
			for(i=0; i < this.bucket_count; i=i+1) {
				var cur: *Node;
				memcpy(&cur,this.buckets+i * sizeof(*Node),sizeof(*Node));
				for(; cur != 0; ) {
					var next: *Node=cur.next;
					var h: u64=stl::hash(cur.key);
					var new_idx: u64=h % new_bucket_count;
					memcpy(&cur.next,new_buckets+new_idx * sizeof(*Node),sizeof(*Node));
					memcpy(new_buckets+new_idx * sizeof(*Node),&cur,sizeof(*Node));
					cur=next;
				}
			}
			free(this.buckets);
			this.buckets=new_buckets;
			this.bucket_count=new_bucket_count;
		}
	};

	# ============================================================
	# PriorityQueue (max-heap when is_max=1, min-heap when is_max=0)
	# ============================================================
	template$T:typename,is_max:i32=1$
	class PriorityQueue {
	public:
		PriorityQueue() {
			this.buffer=0;
			this.sz=0;
			this.cap=0;
		}
		~PriorityQueue() {
			if(this.buffer != 0) {
				free(this.buffer);
			}
		}
		void push(val: T) {
			if(this.sz >= this.cap) {
				var new_cap: u64=this.cap;
				if(new_cap == 0) {
					new_cap=8;
				} else {
					new_cap=new_cap * 2;
				}
				var new_buf: *char=malloc(new_cap * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						memcpy(new_buf,this.buffer,this.sz * sizeof(T));
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.cap=new_cap;
				}
			}
			if(this.buffer != 0) {
				memcpy(this.buffer+this.sz * sizeof(T),&val,sizeof(T));
				this.sz=this.sz+1;
				var idx: u64=this.sz-1;
				while(idx > 0) {
					var parent: u64=(idx-1)/2;
					var cur: T;
					memcpy(&cur,this.buffer+idx * sizeof(T),sizeof(T));
					var pv: T;
					memcpy(&pv,this.buffer+parent * sizeof(T),sizeof(T));
					var need: i32=0;
					if(is_max) {
						if(cur > pv) { need=1; }
					} else {
						if(cur < pv) { need=1; }
					}
					if(need == 0) {
						break;
					}
					memcpy(this.buffer+idx * sizeof(T),&pv,sizeof(T));
					memcpy(this.buffer+parent * sizeof(T),&cur,sizeof(T));
					idx=parent;
				}
			}
		}
		T top() {
			var result: T;
			if(this.sz > 0 && this.buffer != 0) {
				memcpy(&result,this.buffer,sizeof(T));
			}
			return result;
		}
		void pop() {
			if(this.sz > 1) {
				memcpy(this.buffer,this.buffer+(this.sz-1) * sizeof(T),sizeof(T));
				this.sz=this.sz-1;
				var idx: u64=0;
				while(1) {
					var left: u64=idx*2+1;
					if(left >= this.sz) {
						break;
					}
					var right: u64=idx*2+2;
					var target: u64=idx;
					var cur: T;
					memcpy(&cur,this.buffer+idx * sizeof(T),sizeof(T));
					var left_val: T;
					memcpy(&left_val,this.buffer+left * sizeof(T),sizeof(T));
					if(is_max) {
						if(left_val > cur) { target=left; }
					} else {
						if(left_val < cur) { target=left; }
					}
					var right_val: T;
					if(right < this.sz) {
						var target_val: T;
						if(target != idx) {
							memcpy(&target_val,this.buffer+target * sizeof(T),sizeof(T));
						} else {
							memcpy(&target_val,this.buffer+idx * sizeof(T),sizeof(T));
						}
						memcpy(&right_val,this.buffer+right * sizeof(T),sizeof(T));
						if(is_max) {
							if(right_val > target_val) { target=right; }
						} else {
							if(right_val < target_val) { target=right; }
						}
					}
					if(target == idx) {
						break;
					}
					var swap: T;
					memcpy(&swap,this.buffer+idx * sizeof(T),sizeof(T));
					var target_val2: T;
					memcpy(&target_val2,this.buffer+target * sizeof(T),sizeof(T));
					memcpy(this.buffer+idx * sizeof(T),&target_val2,sizeof(T));
					memcpy(this.buffer+target * sizeof(T),&swap,sizeof(T));
					idx=target;
				}
			} else {
				this.sz=0;
			}
		}
		void reserve(min_cap: u64) {
			if(min_cap > this.cap) {
				var new_buf: *char=malloc(min_cap * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						var copy_n: u64=this.sz;
						if(copy_n > min_cap) {
							copy_n=min_cap;
						}
						memcpy(new_buf,this.buffer,copy_n * sizeof(T));
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.cap=min_cap;
				}
			}
		}
		u64 size() {
			return this.sz;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
		buffer: *char;
		sz: u64;
		cap: u64;
	};

	# ============================================================
	# Deque (double-ended queue on ring buffer)
	# ============================================================
	template$T:typename$
	class Deque {
	public:
		Deque() {
			this.buffer=0;
			this.head=0;
			this.tail=0;
			this.sz=0;
			this.cap=0;
		}
		~Deque() {
			if(this.buffer != 0) {
				free(this.buffer);
			}
		}
		void push_front(val: T) {
			if(this.sz >= this.cap) {
				var nc: u64=this.cap;
				if(nc == 0) { nc=8; } else { nc=nc * 2; }
				var nb: *char=malloc(nc * sizeof(T));
				if(nb != 0) {
					if(this.buffer != 0) {
						var i: u64=0;
						for(i=0; i < this.sz; i=i+1) {
							var si: u64=(this.head+i) % this.cap;
							memcpy(nb+i * sizeof(T),
								this.buffer+si * sizeof(T),
								sizeof(T));
						}
						free(this.buffer);
					}
					this.buffer=nb;
					this.head=0;
					this.tail=this.sz;
					this.cap=nc;
				}
			}
			if(this.buffer != 0) {
				if(this.head == 0) {
					this.head=this.cap;
				}
				this.head=this.head-1;
				memcpy(this.buffer+this.head * sizeof(T),&val,sizeof(T));
				this.sz=this.sz+1;
			}
		}
		void push_back(val: T) {
			if(this.sz >= this.cap) {
				var nc: u64=this.cap;
				if(nc == 0) { nc=8; } else { nc=nc * 2; }
				var nb: *char=malloc(nc * sizeof(T));
				if(nb != 0) {
					if(this.buffer != 0) {
						var i: u64=0;
						for(i=0; i < this.sz; i=i+1) {
							var si: u64=(this.head+i) % this.cap;
							memcpy(nb+i * sizeof(T),
								this.buffer+si * sizeof(T),
								sizeof(T));
						}
						free(this.buffer);
					}
					this.buffer=nb;
					this.head=0;
					this.tail=this.sz;
					this.cap=nc;
				}
			}
			if(this.buffer != 0) {
				memcpy(this.buffer+this.tail * sizeof(T),&val,sizeof(T));
				this.tail=(this.tail+1) % this.cap;
				this.sz=this.sz+1;
			}
		}
		void pop_front() {
			if(this.sz > 0) {
				this.head=(this.head+1) % this.cap;
				this.sz=this.sz-1;
			}
		}
		void pop_back() {
			if(this.sz > 0) {
				if(this.tail == 0) {
					this.tail=this.cap;
				}
				this.tail=this.tail-1;
				this.sz=this.sz-1;
			}
		}
		void reserve(min_cap: u64) {
			if(min_cap > this.cap) {
				var new_buf: *char=malloc(min_cap * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						var i: u64=0;
						for(i=0; i < this.sz; i=i+1) {
							var src_idx: u64=(this.head+i) % this.cap;
							memcpy(new_buf+i * sizeof(T),
								this.buffer+src_idx * sizeof(T),
								sizeof(T));
						}
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.head=0;
					this.tail=this.sz;
					this.cap=min_cap;
				}
			}
		}
		T front() {
			var result: T;
			if(this.sz > 0 && this.buffer != 0) {
				memcpy(&result,this.buffer+this.head * sizeof(T),sizeof(T));
			}
			return result;
		}
		T back() {
			var result: T;
			if(this.sz > 0 && this.buffer != 0) {
				var idx: u64=this.tail;
				if(idx == 0) {
					idx=this.cap;
				}
				idx=idx-1;
				memcpy(&result,this.buffer+idx * sizeof(T),sizeof(T));
			}
			return result;
		}
		T get(idx: u64) {
			var result: T;
			if(idx < this.sz && this.buffer != 0) {
				var real_idx: u64=(this.head+idx) % this.cap;
				memcpy(&result,this.buffer+real_idx * sizeof(T),sizeof(T));
			}
			return result;
		}
		void set(idx: u64,val: T) {
			if(idx < this.sz && this.buffer != 0) {
				var real_idx: u64=(this.head+idx) % this.cap;
				memcpy(this.buffer+real_idx * sizeof(T),&val,sizeof(T));
			}
		}
		T operator[](idx: u64) {
			return this.get(idx);
		}
		u64 size() {
			return this.sz;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			this.head=0;
			this.tail=0;
			this.sz=0;
		}
	private:
		buffer: *char;
		head: u64;
		tail: u64;
		sz: u64;
		cap: u64;
	};

	# ============================================================
	# UniquePtr (single ownership pointer)
	# ============================================================
	template$T:typename$
	class UniquePtr {
	public:
		UniquePtr() {
			this.ptr=0;
		}
		~UniquePtr() {
			if(this.ptr != 0) {
				free(this.ptr);
				this.ptr=0;
			}
		}
		T get() {
			var result: T;
			if(this.ptr != 0) {
