			}
			return result;
		}
		*T raw_ptr() {
			return this.ptr;
		}
		i32 is_null() {
			if(this.ptr == 0) {
				return 1;
			}
			return 0;
		}
	private:
		ptr: *T;
	};

	# ============================================================
	# StringView (non-owning string reference)
	# ============================================================
	class StringView {
	public:
		StringView() {
			this.data="";
			this.len=0;
		}
		StringView(s: *char) {
			this.data=s;
			this.len=strlen(s);
		}
		StringView(s: *char,n: u64) {
			this.data=s;
			this.len=n;
		}
		StringView(s: std::string) {
			this.data=s.c_str();
			this.len=s.size();
		}
		char operator[](idx: u64) {
			if(idx < this.len) {
				return this.data[idx];
			}
			return 0;
		}
		u64 size() {
			return this.len;
		}
		i32 empty() {
			if(this.len == 0) {
				return 1;
			}
			return 0;
		}
		*char c_str() {
			return this.data;
		}
		*char data_ptr() {
			return this.data;
		}
		i32 operator==(other: StringView) {
			return this.compare(other) == 0;
		}
		i32 operator!=(other: StringView) {
			return this.compare(other) != 0;
		}
		i32 operator<(other: StringView) {
			if(this.compare(other) < 0) {
				return 1;
			}
			return 0;
		}
		i32 operator>(other: StringView) {
			if(this.compare(other) > 0) {
				return 1;
			}
			return 0;
		}
		i32 compare(other: StringView) {
			var i: u64=0;
			var min_len: u64=this.len;
			if(other.len < min_len) {
				min_len=other.len;
			}
			for(i=0; i < min_len; i=i+1) {
				if(this.data[i] < other.data[i]) {
					return -1;
				}
				if(this.data[i] > other.data[i]) {
					return 1;
				}
			}
			if(this.len < other.len) {
				return -1;
			}
			if(this.len > other.len) {
				return 1;
			}
			return 0;
		}
		i32 starts_with(prefix: *char) {
			var prefix_len: u64=strlen(prefix);
			if(prefix_len > this.len) {
				return 0;
			}
			var i: u64=0;
			for(i=0; i < prefix_len; i=i+1) {
				if(this.data[i] != prefix[i]) {
					return 0;
				}
			}
			return 1;
		}
		i32 ends_with(suffix: *char) {
			var suffix_len: u64=strlen(suffix);
			if(suffix_len > this.len) {
				return 0;
			}
			var i: u64=0;
			for(i=0; i < suffix_len; i=i+1) {
				if(this.data[this.len-suffix_len+i] != suffix[i]) {
					return 0;
				}
			}
			return 1;
		}
		StringView substr(start: u64,len: u64) {
			var sv: StringView;
			if(start >= this.len) {
				return sv;
			}
			var actual_len: u64=len;
			if(start+len > this.len) {
				actual_len=this.len-start;
			}
			sv.data=this.data+start;
			sv.len=actual_len;
			return sv;
		}
		i64 find(sub: *char) {
			var sub_len: u64=strlen(sub);
			if(sub_len > this.len) {
				return -1;
			}
			var i: u64=0;
			for(i=0; i <= this.len-sub_len; i=i+1) {
				var j: u64=0;
				for(j=0; j < sub_len; j=j+1) {
					if(this.data[i+j] != sub[j]) {
						break;
					}
				}
				if(j == sub_len) {
					return i64(i);
				}
			}
			return -1;
		}
	private:
		data: *char;
		len: u64;
	};

	# ============================================================
	# string utilities
	# ============================================================
	i32 str_starts_with(s: *char,prefix: *char) {
		var slen: u64=strlen(s);
		var plen: u64=strlen(prefix);
		if(plen > slen) {
			return 0;
		}
		var i: u64=0;
		for(i=0; i < plen; i=i+1) {
			if(s[i] != prefix[i]) {
				return 0;
			}
		}
		return 1;
	}
	i32 str_ends_with(s: *char,suffix: *char) {
		var slen: u64=strlen(s);
		var suflen: u64=strlen(suffix);
		if(suflen > slen) {
			return 0;
		}
		var i: u64=0;
		var offset: u64=slen-suflen;
		for(i=0; i < suflen; i=i+1) {
			if(s[offset+i] != suffix[i]) {
				return 0;
			}
		}
		return 1;
	}
	i64 str_index_of(s: *char,ch: char) {
		var len: u64=strlen(s);
		var i: u64=0;
		for(i=0; i < len; i=i+1) {
			if(s[i] == ch) {
				return i64(i);
			}
		}
		return -1;
	}
	i64 str_last_index_of(s: *char,ch: char) {
		var len: u64=strlen(s);
		if(len == 0) {
			return -1;
		}
		var i: u64=len;
		for(; i > 0; ) {
			i=i-1;
			if(s[i] == ch) {
				return i64(i);
			}
		}
		return -1;
	}
	i32 char_is_digit(ch: char) {
		if(ch >= '0' && ch <= '9') {
			return 1;
		}
		return 0;
	}
	i32 char_is_alpha(ch: char) {
		if((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')) {
			return 1;
		}
		return 0;
	}
	i32 char_is_alnum(ch: char) {
		if(stl::char_is_digit(ch) || stl::char_is_alpha(ch)) {
			return 1;
		}
		return 0;
	}
	i32 char_is_space(ch: char) {
		if(ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r') {
			return 1;
		}
		return 0;
	}
	i32 char_is_upper(ch: char) {
		if(ch >= 'A' && ch <= 'Z') {
			return 1;
		}
		return 0;
	}
	i32 char_is_lower(ch: char) {
		if(ch >= 'a' && ch <= 'z') {
			return 1;
		}
		return 0;
	}
	char char_to_upper(ch: char) {
		if(ch >= 'a' && ch <= 'z') {
			return ch-32;
		}
		return ch;
	}
	char char_to_lower(ch: char) {
		if(ch >= 'A' && ch <= 'Z') {
			return ch+32;
		}
		return ch;
	}

	# ============================================================
	# algorithm: merge (combine two sorted ranges)
	# ============================================================
	template$T:typename$
	void merge(left: *T,left_n: u64,right: *T,right_n: u64,out: *T) {
		var i: u64=0;
		var j: u64=0;
		var k: u64=0;
		for(; i < left_n && j < right_n; ) {
			if(left[i] <= right[j]) {
				out[k]=left[i];
				i=i+1;
			} else {
				out[k]=right[j];
				j=j+1;
			}
			k=k+1;
		}
		for(; i < left_n; i=i+1) {
			out[k]=left[i];
			k=k+1;
		}
		for(; j < right_n; j=j+1) {
			out[k]=right[j];
			k=k+1;
		}
	}

	# ============================================================
	# algorithm: merge_sort (stable O(n log n))
	# ============================================================
	template$T:typename$
	void merge_sort(ptr: *T,n: u64) {
		if(n <= 1) {
			return;
		}
		if(n <= 16) {
			var i: u64=0;
			for(i=0; i < n-1; i=i+1) {
				var j: u64=0;
				for(j=0; j < n-1-i; j=j+1) {
					if(ptr[j] > ptr[j+1]) {
						var tmp: T=ptr[j];
						ptr[j]=ptr[j+1];
						ptr[j+1]=tmp;
					}
				}
			}
			return;
		}
		var mid: u64=n/2;
		merge_sort(ptr,mid);
		merge_sort(ptr+mid,n-mid);
		var tmp: *T=*T(malloc(n * sizeof(T)));
		if(tmp != 0) {
			merge(ptr,mid,ptr+mid,n-mid,tmp);
			var i: u64=0;
			for(i=0; i < n; i=i+1) {
				ptr[i]=tmp[i];
			}
			free(tmp);
		}
	}

	# ============================================================
	# algorithm: set_union
	# ============================================================
	template$T:typename$
	u64 set_union(a: *T,na: u64,b: *T,nb: u64,out: *T) {
		var i: u64=0;
		var j: u64=0;
		var k: u64=0;
		for(; i < na && j < nb; ) {
			if(a[i] < b[j]) {
				out[k]=a[i];
				i=i+1;
			} else if(b[j] < a[i]) {
				out[k]=b[j];
				j=j+1;
			} else {
				out[k]=a[i];
				i=i+1;
				j=j+1;
			}
			k=k+1;
		}
		for(; i < na; i=i+1) {
			out[k]=a[i];
			k=k+1;
		}
		for(; j < nb; j=j+1) {
			out[k]=b[j];
			k=k+1;
		}
		return k;
	}

	# ============================================================
	# algorithm: set_intersection
	# ============================================================
	template$T:typename$
	u64 set_intersection(a: *T,na: u64,b: *T,nb: u64,out: *T) {
		var i: u64=0;
		var j: u64=0;
		var k: u64=0;
		for(; i < na && j < nb; ) {
			if(a[i] < b[j]) {
				i=i+1;
			} else if(b[j] < a[i]) {
				j=j+1;
			} else {
				out[k]=a[i];
				i=i+1;
				j=j+1;
				k=k+1;
			}
		}
		return k;
	}

	# ============================================================
	# algorithm: set_difference
	# ============================================================
	template$T:typename$
	u64 set_difference(a: *T,na: u64,b: *T,nb: u64,out: *T) {
		var i: u64=0;
		var j: u64=0;
		var k: u64=0;
		for(; i < na && j < nb; ) {
			if(a[i] < b[j]) {
				out[k]=a[i];
				i=i+1;
				k=k+1;
			} else if(b[j] < a[i]) {
				j=j+1;
			} else {
				i=i+1;
				j=j+1;
			}
		}
		for(; i < na; i=i+1) {
			out[k]=a[i];
			k=k+1;
		}
		return k;
	}

	# ============================================================
	# algorithm: set_symmetric_difference
	# ============================================================
	template$T:typename$
	u64 set_symmetric_difference(a: *T,na: u64,b: *T,nb: u64,out: *T) {
		var i: u64=0;
		var j: u64=0;
		var k: u64=0;
		for(; i < na && j < nb; ) {
			if(a[i] < b[j]) {
				out[k]=a[i];
				i=i+1;
			} else if(b[j] < a[i]) {
				out[k]=b[j];
				j=j+1;
			} else {
				i=i+1;
				j=j+1;
			}
			k=k+1;
		}
		for(; i < na; i=i+1) {
			out[k]=a[i];
			k=k+1;
		}
		for(; j < nb; j=j+1) {
			out[k]=b[j];
			k=k+1;
		}
		return k;
	}

	# ============================================================
	# algorithm: partial_sum
	# ============================================================
	template$T:typename$
	void partial_sum(src: *T,dst: *T,n: u64) {
		if(n == 0) {
			return;
		}
		dst[0]=src[0];
		var i: u64=1;
		for(i=1; i < n; i=i+1) {
			dst[i]=dst[i-1]+src[i];
		}
	}

	# ============================================================
	# algorithm: adjacent_difference
	# ============================================================
	template$T:typename$
	void adjacent_difference(src: *T,dst: *T,n: u64) {
		if(n == 0) {
			return;
		}
		dst[0]=src[0];
		var i: u64=1;
		for(i=1; i < n; i=i+1) {
			dst[i]=src[i]-src[i-1];
		}
	}

	# ============================================================
	# algorithm: inner_product
	# ============================================================
	template$T:typename$
	T inner_product(a: *T,b: *T,n: u64,init: T) {
		var result: T=init;
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			result=result+a[i]*b[i];
		}
		return result;
	}

	# ============================================================
	# algorithm: min_element / max_element
	# ============================================================
	template$T:typename$
	i64 min_element(ptr: *T,n: u64) {
		if(n == 0) {
			return -1;
		}
		var min_idx: u64=0;
		var i: u64=1;
		for(i=1; i < n; i=i+1) {
			if(ptr[i] < ptr[min_idx]) {
				min_idx=i;
			}
		}
		return i64(min_idx);
	}
	template$T:typename$
	i64 max_element(ptr: *T,n: u64) {
		if(n == 0) {
			return -1;
		}
		var max_idx: u64=0;
		var i: u64=1;
		for(i=1; i < n; i=i+1) {
			if(ptr[i] > ptr[max_idx]) {
				max_idx=i;
			}
		}
		return i64(max_idx);
	}

	# ============================================================
	# algorithm: equal / lexicographical_compare
	# ============================================================
	template$T:typename$
	i32 equal(a: *T,na: u64,b: *T,nb: u64) {
		if(na != nb) {
			return 0;
		}
		var i: u64=0;
		for(i=0; i < na; i=i+1) {
			if(a[i] != b[i]) {
				return 0;
			}
		}
		return 1;
	}
	template$T:typename$
	i32 lexicographical_compare(a: *T,na: u64,b: *T,nb: u64) {
		var min_n: u64=na;
		if(nb < min_n) {
			min_n=nb;
		}
		var i: u64=0;
		for(i=0; i < min_n; i=i+1) {
			if(a[i] < b[i]) {
				return -1;
			}
			if(b[i] < a[i]) {
				return 1;
			}
		}
		if(na < nb) {
			return -1;
		}
		if(na > nb) {
			return 1;
		}
		return 0;
	}

	# ============================================================
	# algorithm: copy_if (copies elements matching pred value)
	# ============================================================
	template$T:typename$
	u64 copy_if(src: *T,dst: *T,n: u64,pred: T) {
		var j: u64=0;
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(src[i] == pred) {
				dst[j]=src[i];
				j=j+1;
			}
		}
		return j;
	}

	# ============================================================
	# algorithm: remove_if (in-place, returns new size)
	# ============================================================
	template$T:typename$
	u64 remove_if(ptr: *T,n: u64,val: T) {
		var j: u64=0;
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] != val) {
				ptr[j]=ptr[i];
				j=j+1;
			}
		}
		return j;
	}

	# ============================================================
	# algorithm: shift_left / shift_right
	# ============================================================
	template$T:typename$
	void shift_left(ptr: *T,n: u64,k: u64) {
		if(k >= n) {
			return;
		}
		var i: u64=0;
		for(i=0; i < n-k; i=i+1) {
			ptr[i]=ptr[i+k];
		}
	}
	template$T:typename$
	void shift_right(ptr: *T,n: u64,k: u64) {
		if(k >= n) {
			return;
		}
		var i: u64=n;
		for(; i > k; ) {
			i=i-1;
			ptr[i]=ptr[i-k];
		}
	}

	# ============================================================
	# algorithm: generate (fill with value)
	# ============================================================
	template$T:typename$
	void generate(ptr: *T,n: u64,val: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			ptr[i]=val;
		}
	}

	# ============================================================
	# algorithm: heap operations
	# ============================================================
	template$T:typename$
	void sift_down_heap(ptr: *T,n: u64,idx: u64) {
		var largest: u64=idx;
		var left: u64=2*idx+1;
		var right: u64=2*idx+2;
		if(left < n && ptr[left] > ptr[largest]) {
			largest=left;
		}
		if(right < n && ptr[right] > ptr[largest]) {
			largest=right;
		}
		if(largest != idx) {
			var tmp: T=ptr[idx];
			ptr[idx]=ptr[largest];
			ptr[largest]=tmp;
			sift_down_heap(ptr,n,largest);
		}
	}
	template$T:typename$
	void sift_up_heap(ptr: *T,n: u64,idx: u64) {
		if(idx == 0) {
			return;
		}
		var parent: u64=(idx-1)/2;
		if(ptr[idx] > ptr[parent]) {
			var tmp: T=ptr[idx];
			ptr[idx]=ptr[parent];
			ptr[parent]=tmp;
			sift_up_heap(ptr,n,parent);
		}
	}
	template$T:typename$
	i32 is_heap(ptr: *T,n: u64) {
		var i: u64=1;
		for(i=1; i < n; i=i+1) {
			var parent: u64=(i-1)/2;
			if(ptr[parent] < ptr[i]) {
				return 0;
			}
		}
		return 1;
	}
	template$T:typename$
	void make_heap(ptr: *T,n: u64) {
		if(n <= 1) {
			return;
		}
		var i: u64=n/2;
		for(; i > 0; ) {
			i=i-1;
			sift_down_heap(ptr,n,i);
		}
	}
	template$T:typename$
	void push_heap(ptr: *T,n: u64,val: T) {
		ptr[n]=val;
		sift_up_heap(ptr,n+1,n);
	}
	template$T:typename$
	void pop_heap(ptr: *T,n: u64) {
		if(n <= 1) {
			return;
		}
		ptr[0]=ptr[n-1];
		sift_down_heap(ptr,n-1,0);
	}
	template$T:typename$
	void sort_heap(ptr: *T,n: u64) {
		var i: u64=n;
		for(; i > 1; i=i-1) {
			var tmp: T=ptr[0];
			ptr[0]=ptr[i-1];
			ptr[i-1]=tmp;
			sift_down_heap(ptr,i-1,0);
		}
	}

	# ============================================================
	# algorithm: partial_sort
	# ============================================================
	template$T:typename$
	void partial_sort(ptr: *T,n: u64,k: u64) {
		if(k >= n) {
			std::sort(ptr,n);
			return;
		}
		if(k == 0) {
			return;
		}
		make_heap(ptr,k);
		var i: u64=k;
		for(i=k; i < n; i=i+1) {
			if(ptr[i] < ptr[0]) {
				var tmp: T=ptr[0];
				ptr[0]=ptr[i];
				ptr[i]=tmp;
				sift_down_heap(ptr,k,0);
			}
		}
		sort_heap(ptr,k);
	}

	# ============================================================
	# algorithm: stable_sort (merge sort wrapper)
	# ============================================================
	template$T:typename$
	void stable_sort(ptr: *T,n: u64) {
		merge_sort(ptr,n);
	}

	# ============================================================
	# random: XorShift128+ engine
	# ============================================================
	class Random {
	public:
		Random() {
			this.seed(123456789);
		}
		Random(seed_val: u64) {
			this.seed(seed_val);
		}
		void seed(seed_val: u64) {
			this.state0=seed_val;
			this.state1=seed_val ^ 0x9E3779B97F4A7C15;
		}
		u64 next_u64() {
			var s1: u64=this.state0;
			var s0: u64=this.state1;
			this.state0=s0;
			s1=s1 ^ (s1 << 23);
			s1=s1 ^ (s1 >> 17);
			s1=s1 ^ s0;
			s1=s1 ^ (s0 >> 26);
			this.state1=s1;
			return this.state0+this.state1;
		}
		u32 next_u32() {
			return u32(this.next_u64());
		}
		i32 next_i32() {
			return i32(this.next_u32());
		}
		i64 next_i64() {
			return i64(this.next_u64());
		}
		f64 next_f64() {
			var v: u64=this.next_u64();
			v=v >> 11;
			v=v | 0x3FF0000000000000;
			var result: f64;
			memcpy(&result,&v,sizeof(f64));
			return result-1.0;
		}
		f64 next_f64_range(lo: f64,hi: f64) {
			return lo+this.next_f64()*(hi-lo);
		}
		i32 next_i32_range(lo: i32,hi: i32) {
			var range: u32=u32(hi-lo+1);
			return lo+i32(this.next_u32() % u64(range));
		}
	private:
		state0: u64;
		state1: u64;
	};

	# ============================================================
	# Counter / multiset
	# ============================================================
	template$T:typename$
	class Counter {
	public:
		Counter() {}
		void inc(key: T) {
			var count: i64=this.map.get_or(key,0);
			this.map.insert(key,count+1);
		}
		void add(key: T,delta: i64) {
			var count: i64=this.map.get_or(key,0);
			this.map.insert(key,count+delta);
		}
		void dec(key: T) {
			var count: i64=this.map.get_or(key,0);
			if(count > 0) {
				this.map.insert(key,count-1);
			}
		}
		i64 get(key: T) {
			return this.map.get_or(key,0);
		}
		void clear() {
			this.map.clear();
		}
		u64 size() {
			return this.map.size();
		}
		i32 empty() {
			return this.map.empty();
		}
	private:
		map: stl::HashMap$T,i64$;
	};

	# ============================================================
	# Disjoint Set Union (Union-Find)
	# ============================================================
	class DSU {
	public:
		DSU(n: u64) {
			this.n=n;
			this.parent=malloc(n * sizeof(u64));
			this.rank=malloc(n * sizeof(u64));
			var i: u64=0;
			for(i=0; i < n; i=i+1) {
				this.parent[i]=i;
				this.rank[i]=0;
			}
		}
		~DSU() {
			if(this.parent != 0) {
				free(this.parent);
			}
			if(this.rank != 0) {
				free(this.rank);
			}
		}
		u64 find(x: u64) {
			if(x >= this.n) {
				return x;
			}
			if(this.parent[x] != x) {
				this.parent[x]=this.find(this.parent[x]);
			}
			return this.parent[x];
		}
		void unite(a: u64,b: u64) {
			var ra: u64=this.find(a);
			var rb: u64=this.find(b);
			if(ra == rb) {
				return;
			}
			if(this.rank[ra] < this.rank[rb]) {
				this.parent[ra]=rb;
			} else if(this.rank[ra] > this.rank[rb]) {
				this.parent[rb]=ra;
			} else {
				this.parent[rb]=ra;
				this.rank[ra]=this.rank[ra]+1;
			}
		}
		i32 connected(a: u64,b: u64) {
			if(this.find(a) == this.find(b)) {
				return 1;
			}
			return 0;
		}
		u64 set_size(x: u64) {
			var root: u64=this.find(x);
			var count: u64=0;
			var i: u64=0;
			for(i=0; i < this.n; i=i+1) {
				if(this.find(i) == root) {
					count=count+1;
				}
			}
			return count;
		}
		u64 set_count() {
			var count: u64=0;
			var i: u64=0;
			for(i=0; i < this.n; i=i+1) {
				if(this.parent[i] == i) {
					count=count+1;
				}
			}
			return count;
		}
	private:
		parent: *u64;
		rank: *u64;
		n: u64;
	};

	# ============================================================
	# BitSet (like C++ std::bitset with dynamic size)
	# ============================================================
	class BitSet {
	public:
		BitSet(n: u64) {
			this.num_bits=n;
			var num_bytes: u64=(n+7)/8;
			this.data=malloc(num_bytes);
			if(this.data != 0) {
				var i: u64=0;
				for(i=0; i < num_bytes; i=i+1) {
					this.data[i]=0;
				}
			}
		}
		~BitSet() {
			if(this.data != 0) {
				free(this.data);
			}
		}
		void set(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx / 8;
				var bit_idx: u64=idx % 8;
				this.data[byte_idx]=this.data[byte_idx] | (1 << bit_idx);
			}
		}
		void reset(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx / 8;
				var bit_idx: u64=idx % 8;
				this.data[byte_idx]=this.data[byte_idx] & ~(1 << bit_idx);
			}
		}
		void flip(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx / 8;
				var bit_idx: u64=idx % 8;
				this.data[byte_idx]=this.data[byte_idx] ^ (1 << bit_idx);
			}
		}
		i32 test(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx / 8;
				var bit_idx: u64=idx % 8;
				if(this.data[byte_idx] & (1 << bit_idx)) {
					return 1;
				}
			}
			return 0;
		}
		u64 size() {
			return this.num_bits;
		}
		i32 all() {
			if(this.data == 0) {
				return 0;
			}
			var num_bytes: u64=(this.num_bits+7)/8;
			var full_bytes: u64=this.num_bits / 8;
			var i: u64=0;
			for(i=0; i < full_bytes; i=i+1) {
				if(this.data[i] != 0xFF) {
					return 0;
				}
			}
			var rem: u64=this.num_bits % 8;
			if(rem > 0) {
				var shift: i32=(1 << rem)-1;
				if((i32(this.data[full_bytes]) & shift) != shift) {
					return 0;
				}
			}
			return 1;
		}
		i32 any() {
			if(this.data == 0) {
				return 0;
			}
			var num_bytes: u64=(this.num_bits+7)/8;
			var i: u64=0;
			for(i=0; i < num_bytes; i=i+1) {
				if(this.data[i] != 0) {
					return 1;
				}
			}
			return 0;
		}
		i32 none() {
			return !this.any();
		}
		u64 count() {
			var result: u64=0;
			if(this.data == 0) {
				return result;
			}
			var num_bytes: u64=(this.num_bits+7)/8;
			var i: u64=0;
			for(i=0; i < num_bytes; i=i+1) {
				var byte_val: u8=this.data[i];
				for(; byte_val > 0; ) {
					result=result+u64(byte_val & 1);
					byte_val=byte_val >> 1;
				}
			}
			return result;
		}
		void clear() {
			if(this.data != 0) {
				var num_bytes: u64=(this.num_bits+7)/8;
				var i: u64=0;
				for(i=0; i < num_bytes; i=i+1) {
					this.data[i]=0;
				}
			}
		}
	private:
		data: *char;
		num_bits: u64;
	};
}
@end