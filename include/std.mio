	extern f64 rad_to_deg(rad: f64);

	# ============================================================
	# numeric limits
	# ============================================================
	const PI: f64=3.14159265358979323846;
	const E: f64=2.71828182845904523536;
	const I32_MAX: i32=2147483647;
	const I32_MIN: i32=-2147483648;
	const I64_MAX: i64=9223372036854775807;
	const I64_MIN: i64=-9223372036854775808;

	# ============================================================
	# memory
	# ============================================================
	template$T:typename$
	*T allocate(n: u64) {
		return *T(malloc(n * sizeof(T)));
	}
	template$T:typename$
	void deallocate(ptr: *T) {
		if(ptr != 0) {
			free(*char(ptr));
		}
	}
	template$T:typename$
	*T reallocate(ptr: *T,n: u64) {
		return *T(realloc(*char(ptr),n * sizeof(T)));
	}

	# ============================================================
	# pair
	# ============================================================
	template$T:typename,U:typename$
	void make_pair(first: *T,second: *U,out_first: *T,out_second: *U) {
		*out_first=*first;
		*out_second=*second;
	}

	# ============================================================
	# string
	# ============================================================
	class string {
	public:
		string() {
			this.data="";
			this.len=0;
		}
		string(s: *char) {
			this.len=strlen(s);
			this.data=malloc(this.len+1);
			if(this.data != 0) {
				memcpy(this.data,s,this.len+1);
			} else {
				this.len=0;
			}
		}
		string(s: string) {
			this.len=s.len;
			this.data=malloc(this.len+1);
			if(this.data != 0) {
				memcpy(this.data,s.data,this.len+1);
			}
		}
		~string() {
			if(this.data != 0 && this.len > 0) {
				free(this.data);
			}
		}
		string operator+(s: *char) {
			var result: string;
			var s_len: u64=strlen(s);
			result.len=this.len+s_len;
			result.data=malloc(result.len+1);
			if(result.data != 0) {
				memcpy(result.data,this.data,this.len);
				memcpy(result.data+this.len,s,s_len+1);
			}
			return result;
		}
		string operator+(other: string) {
			return this+other.data;
		}
		void operator+=(s: *char) {
			var new_len: u64=this.len+strlen(s);
			var new_data: *char=malloc(new_len+1);
			if(new_data != 0) {
				memcpy(new_data,this.data,this.len);
				memcpy(new_data+this.len,s,strlen(s)+1);
				if(this.data != 0 && this.len > 0) {
					free(this.data);
				}
				this.data=new_data;
				this.len=new_len;
			}
		}
		void operator+=(other: string) {
			var new_len: u64=this.len+other.len;
			var new_data: *char=malloc(new_len+1);
			if(new_data != 0) {
				memcpy(new_data,this.data,this.len);
				memcpy(new_data+this.len,other.data,other.len+1);
				if(this.data != 0 && this.len > 0) {
					free(this.data);
				}
				this.data=new_data;
				this.len=new_len;
			}
		}
		i32 operator==(s: *char) {
			if(strcmp(this.data,s) == 0) {
				return 1;
			}
			return 0;
		}
		i32 operator==(other: string) {
			return this == other.data;
		}
		i32 operator!=(s: *char) {
			return !(this == s);
		}
		i32 operator!=(other: string) {
			return !(this == other);
		}
		i32 operator<(other: string) {
			if(strcmp(this.data,other.data) < 0) {
				return 1;
			}
			return 0;
		}
		i32 operator>(other: string) {
			if(strcmp(this.data,other.data) > 0) {
				return 1;
			}
			return 0;
		}
		i32 operator<=(other: string) {
			if(strcmp(this.data,other.data) <= 0) {
				return 1;
			}
			return 0;
		}
		i32 operator>=(other: string) {
			if(strcmp(this.data,other.data) >= 0) {
				return 1;
			}
			return 0;
		}
		char operator[](idx: u64) {
			if(idx < this.len) {
				return this.data[idx];
			}
			return 0;
		}
		string operator=(other: string) {
			if(this.data != 0 && this.len > 0) {
				free(this.data);
			}
			this.len=other.len;
			this.data=malloc(this.len+1);
			if(this.data != 0) {
				memcpy(this.data,other.data,this.len+1);
			}
			return this;
		}
		*char c_str() {
			return this.data;
		}
		u64 size() {
			return this.len;
		}
		i32 empty() {
			if(this.len == 0) {
				return 1;
			}
			return 0;
		}
		void append(s: *char) {
			var new_len: u64=this.len+strlen(s);
			var new_data: *char=malloc(new_len+1);
			if(new_data != 0) {
				memcpy(new_data,this.data,this.len);
				memcpy(new_data+this.len,s,strlen(s)+1);
				if(this.data != 0 && this.len > 0) {
					free(this.data);
				}
				this.data=new_data;
				this.len=new_len;
			}
		}
		void append_string(other: string) {
			this += other;
		}
		i32 compare(s: *char) {
			return strcmp(this.data,s);
		}
		i32 equals(s: *char) {
			return this == s;
		}
		i32 contains(sub: *char) {
			if(strstr(this.data,sub) != 0) {
				return 1;
			}
			return 0;
		}
		char char_at(idx: u64) {
			return this[idx];
		}
		string substr(start: u64,len: u64) {
			var result: string;
			if(start >= this.len) {
				return result;
			}
			var actual_len: u64=len;
			if(start+len > this.len) {
				actual_len=this.len-start;
			}
			result.data=malloc(actual_len+1);
			if(result.data != 0) {
				memcpy(result.data,this.data+start,actual_len);
				result.data[actual_len]=0;
				result.len=actual_len;
			}
			return result;
		}
		i64 find(sub: *char) {
			var sub_len: u64=strlen(sub);
			if(sub_len > this.len) {
				return -1;
			}
			var i: u64=0;
			for(i=0; i <= this.len-sub_len; i=i+1) {
				var j: u64=0;
				for(j=0; j < sub_len; j=j+1) {
					if(this.data[i+j] != sub[j]) {
						break;
					}
				}
				if(j == sub_len) {
					return i64(i);
				}
			}
			return -1;
		}
		void clear() {
			if(this.data != 0 && this.len > 0) {
				free(this.data);
			}
			this.data="";
			this.len=0;
		}
	private:
		data: *char;
		len: u64;
	};

	# ============================================================
	# vector
	# ============================================================
	template$T:typename$
	class vector {
	public:
		vector() {
			this.buffer=0;
			this.sz=0;
			this.cap=0;
		}
		~vector() {
			if(this.buffer != 0) {
				free(this.buffer);
				this.buffer=0;
			}
			this.sz=0;
			this.cap=0;
		}
		T operator[](idx: u64) {
			return this.get(idx);
		}
		void push_back(val: T) {
			if(this.sz >= this.cap) {
				var new_cap: u64=this.cap;
				if(new_cap == 0) {
					new_cap=4;
				} else {
					new_cap=new_cap * 2;
				}
				var new_buf: *char=malloc(new_cap * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						memcpy(new_buf,this.buffer,this.sz * sizeof(T));
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.cap=new_cap;
				}
			}
			if(this.buffer != 0) {
				memcpy(this.buffer+this.sz * sizeof(T),&val,sizeof(T));
				this.sz=this.sz+1;
			}
		}
		void pop_back() {
			if(this.sz > 0) {
				this.sz=this.sz-1;
			}
		}
		T get(idx: u64) {
			var result: T;
			if(idx < this.sz && this.buffer != 0) {
				memcpy(&result,this.buffer+idx * sizeof(T),sizeof(T));
			}
			return result;
		}
		void set(idx: u64,val: T) {
			if(idx < this.sz && this.buffer != 0) {
				memcpy(this.buffer+idx * sizeof(T),&val,sizeof(T));
			}
		}
		*char data() {
			return this.buffer;
		}
		u64 size() {
			return this.sz;
		}
		u64 capacity() {
			return this.cap;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			this.sz=0;
		}
		void reserve(n: u64) {
			if(n > this.cap) {
				var new_buf: *char=malloc(n * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						memcpy(new_buf,this.buffer,this.sz * sizeof(T));
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.cap=n;
				}
			}
		}
		void erase(idx: u64) {
			if(idx < this.sz) {
				var i: u64=idx;
				for(i=idx; i < this.sz-1; i=i+1) {
					memcpy(this.buffer+i * sizeof(T),
						this.buffer+(i+1) * sizeof(T),
						sizeof(T));
				}
				this.sz=this.sz-1;
			}
		}
		private:
		buffer: *char;
		sz: u64;
		cap: u64;
	};

	# ============================================================
	# optional
	# ============================================================
	template$T:typename$
	class optional {
	public:
		optional() {
			this.has_value=0;
		}
		optional(val: T) {
			this.value=val;
			this.has_value=1;
		}
		i32 has_value() {
			return this.has_value;
		}
		T value() {
			return this.value;
		}
		T value_or(default_val: T) {
			if(this.has_value) {
				return this.value;
			}
			return default_val;
		}
		void reset() {
			this.has_value=0;
		}
	private:
		value: T;
		has_value: i32;
	};

	# ============================================================
	# result (Either success or error)
	# ============================================================
	template$T:typename,E:typename$
	class result {
	public:
		result_ok(val: T) {
			this.value=val;
			this.is_ok=1;
		}
		result_err(err: E) {
			this.error=err;
			this.is_ok=0;
		}
		i32 is_ok() {
			return this.is_ok;
		}
		i32 is_err() {
			return !this.is_ok;
		}
		T unwrap() {
			return this.value;
		}
		E unwrap_err() {
			return this.error;
		}
		T unwrap_or(default_val: T) {
			if(this.is_ok) {
				return this.value;
			}
			return default_val;
		}
	private:
		value: T;
		error: E;
		is_ok: i32;
	};

	# ============================================================
	# Tuple (up to 3 elements)
