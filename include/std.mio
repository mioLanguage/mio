	extern f64 cos(x: f64);
	extern f64 tan(x: f64);
	extern f64 asin(x: f64);
	extern f64 acos(x: f64);
	extern f64 atan(x: f64);
	extern f64 atan2(y: f64,x: f64);
	extern f64 sqrt(x: f64);
	extern f64 pow(x: f64,y: f64);
	extern f64 floor(x: f64);
	extern f64 ceil(x: f64);
