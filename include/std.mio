@if !STD
macro STD;
import "stdlib";
import "string";
import "stdio";

namespace std {
	# ============================================================
	# utility
	# ============================================================
	template$T:typename$
	void swap(a: *T,b: *T) {
		var tmp: T=*a;
		*a=*b;
		*b=tmp;
	}
	template$T:typename$
	T min(a: T,b: T) {
		if(a < b) {
			return a;
		}
		return b;
	}
	template$T:typename$
	T max(a: T,b: T) {
		if(a > b) {
			return a;
		}
		return b;
	}
	template$T:typename$
	T clamp(x: T,lo: T,hi: T) {
		if(x < lo) {
			return lo;
		}
		if(x > hi) {
			return hi;
		}
		return x;
	}
	template$T:typename$
	i32 compare(a: T,b: T) {
		if(a < b) {
			return -1;
		}
		if(a > b) {
			return 1;
		}
		return 0;
	}

	# ============================================================
	# algorithm
	# ============================================================
	template$T:typename$
	i64 find(ptr: *T,n: u64,val: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] == val) {
				return i64(i);
			}
		}
		return -1;
	}
	template$T:typename$
	i64 find_last(ptr: *T,n: u64,val: T) {
		if(n == 0) {
			return -1;
		}
		var i: u64=n;
		for(; i > 0; ) {
			i=i-1;
			if(ptr[i] == val) {
				return i64(i);
			}
		}
		return -1;
	}
	template$T:typename$
	i64 adjacent_find(ptr: *T,n: u64) {
		if(n < 2) {
			return -1;
		}
		var i: u64=0;
		for(i=0; i < n-1; i=i+1) {
			if(ptr[i] == ptr[i+1]) {
				return i64(i);
			}
		}
		return -1;
	}
	template$T:typename$
	void fill(ptr: *T,n: u64,val: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			ptr[i]=val;
		}
	}
	template$T:typename$
	void copy(src: *T,dst: *T,n: u64) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			dst[i]=src[i];
		}
	}
	template$T:typename$
	void reverse(ptr: *T,n: u64) {
		var i: u64=0;
		var j: u64=n;
		if(j == 0) {
			return;
		}
		j=j-1;
		for(; i < j; i=i+1) {
			var tmp: T=ptr[i];
			ptr[i]=ptr[j];
			ptr[j]=tmp;
			j=j-1;
		}
	}
	template$T:typename$
	void rotate(ptr: *T,n: u64,k: u64) {
		if(n <= 1 || k == 0) {
			return;
		}
		var shift: u64=k % n;
		if(shift == 0) {
			return;
		}
		var i: u64=0;
		for(i=0; i < shift; i=i+1) {
			var tmp: T=ptr[0];
			var j: u64=0;
			for(j=0; j < n-1; j=j+1) {
				ptr[j]=ptr[j+1];
			}
			ptr[n-1]=tmp;
		}
	}
	template$T:typename$
	void sort(ptr: *T,n: u64) {
		if(n <= 1) {
			return;
		}
		var i: u64=0;
		for(i=0; i < n-1; i=i+1) {
			var j: u64=0;
			for(j=0; j < n-1-i; j=j+1) {
				if(ptr[j] > ptr[j+1]) {
					var tmp: T=ptr[j];
					ptr[j]=ptr[j+1];
					ptr[j+1]=tmp;
				}
			}
		}
	}
	template$T:typename$
	i32 binary_search(ptr: *T,n: u64,val: T) {
		var lo: i64=0;
		var hi: i64=i64(n)-1;
		for(; lo <= hi; ) {
			var mid: i64=(lo+hi)/2;
			if(ptr[mid] == val) {
				return 1;
			}
			if(ptr[mid] < val) {
				lo=mid+1;
			} else {
				hi=mid-1;
			}
		}
		return 0;
	}
	template$T:typename$
	i64 lower_bound(ptr: *T,n: u64,val: T) {
		var lo: i64=0;
		var hi: i64=i64(n);
		for(; lo < hi; ) {
			var mid: i64=(lo+hi)/2;
			if(ptr[mid] < val) {
				lo=mid+1;
			} else {
				hi=mid;
			}
		}
		return lo;
	}
	template$T:typename$
	i64 upper_bound(ptr: *T,n: u64,val: T) {
		var lo: i64=0;
		var hi: i64=i64(n);
		for(; lo < hi; ) {
			var mid: i64=(lo+hi)/2;
			if(ptr[mid] <= val) {
				lo=mid+1;
			} else {
				hi=mid;
			}
		}
		return lo;
	}
	template$T:typename$
	i32 all_of(ptr: *T,n: u64,pred: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] != pred) {
				return 0;
			}
		}
		return 1;
	}
	template$T:typename$
	i32 any_of(ptr: *T,n: u64,pred: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] == pred) {
				return 1;
			}
		}
		return 0;
	}
	template$T:typename$
	i32 none_of(ptr: *T,n: u64,pred: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] == pred) {
				return 0;
			}
		}
		return 1;
	}
	template$T:typename$
	u64 count(ptr: *T,n: u64,val: T) {
		var c: u64=0;
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] == val) {
				c=c+1;
			}
		}
		return c;
	}
	template$T:typename$
	void replace(ptr: *T,n: u64,old_val: T,new_val: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			if(ptr[i] == old_val) {
				ptr[i]=new_val;
			}
		}
	}
	template$T:typename$
	i32 is_sorted(ptr: *T,n: u64) {
		if(n <= 1) {
			return 1;
		}
		var i: u64=0;
		for(i=0; i < n-1; i=i+1) {
			if(ptr[i] > ptr[i+1]) {
				return 0;
			}
		}
		return 1;
	}
	template$T:typename$
	u64 unique(ptr: *T,n: u64) {
		if(n <= 1) {
			return n;
		}
		var j: u64=0;
		var i: u64=1;
		for(i=1; i < n; i=i+1) {
			if(ptr[i] != ptr[j]) {
				j=j+1;
				ptr[j]=ptr[i];
			}
		}
		return j+1;
	}
	template$T:typename$
	void iota(ptr: *T,n: u64,start: T) {
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			ptr[i]=start;
			start=start+1;
		}
	}
	template$T:typename$
	T accumulate(ptr: *T,n: u64,init: T) {
		var result: T=init;
		var i: u64=0;
		for(i=0; i < n; i=i+1) {
			result=result+ptr[i];
		}
		return result;
	}
	template$T:typename$
	i32 next_permutation(ptr: *T,n: u64) {
		if(n <= 1) {
			return 0;
		}
		var i: i64=i64(n)-2;
		for(; i >= 0 && ptr[i] >= ptr[i+1]; i=i-1) {
		}
		if(i < 0) {
			reverse(ptr,n);
			return 0;
		}
		var j: i64=i64(n)-1;
		for(; ptr[j] <= ptr[i]; j=j-1) {
		}
		swap(ptr+i,ptr+j);
		var l: i64=i+1;
		var r: i64=i64(n)-1;
		for(; l < r; l=l+1) {
			var tmp: T=ptr[l];
			ptr[l]=ptr[r];
			ptr[r]=tmp;
			r=r-1;
		}
		return 1;
	}
	template$T:typename$
	i32 prev_permutation(ptr: *T,n: u64) {
		if(n <= 1) {
			return 0;
		}
		var i: i64=i64(n)-2;
		for(; i >= 0 && ptr[i] <= ptr[i+1]; i=i-1) {
		}
		if(i < 0) {
			reverse(ptr,n);
			return 0;
		}
		var j: i64=i64(n)-1;
		for(; ptr[j] >= ptr[i]; j=j-1) {
		}
		swap(ptr+i,ptr+j);
		var l: i64=i+1;
		var r: i64=i64(n)-1;
		for(; l < r; l=l+1) {
			var tmp: T=ptr[l];
			ptr[l]=ptr[r];
			ptr[r]=tmp;
			r=r-1;
		}
		return 1;
	}

