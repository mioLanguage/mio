	extern f64 fmod(x: f64,y: f64);
	extern f64 log(x: f64);
	extern f64 log10(x: f64);
	extern f64 exp(x: f64);
	extern f64 sinh(x: f64);
	extern f64 cosh(x: f64);
	extern f64 tanh(x: f64);

	# ============================================================
	# math: mio-implemented math functions (bodies in Imp/std.mio)
	# ============================================================
	template$T:typename$
	T abs(x: T) {
		if(x < 0) {
			return -x;
		}
		return x;
	}
	extern f64 pow_i(base: f64,exp: i32);
	extern f64 factorial(n: i32);
	extern i32 gcd(a: i32,b: i32);
	extern i32 lcm(a: i32,b: i32);
	extern i32 is_prime(n: i32);
