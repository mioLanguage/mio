	};

	# ============================================================
	# LinkedList
	# ============================================================
	template$T:typename$
	class LinkedList {
	public:
		LinkedList() {
			this.head=0;
			this.tail=0;
			this.sz=0;
		}
		~LinkedList() {
			this.clear();
		}
		void push_front(val: T) {
			var node: *ListNode=*LinkedList::ListNode(malloc(sizeof(ListNode)));
			if(node != 0) {
				node.value=val;
				node.next=this.head;
				node.prev=0;
				if(this.head != 0) {
					this.head.prev=node;
				}
				this.head=node;
				if(this.tail == 0) {
					this.tail=node;
				}
				this.sz=this.sz+1;
			}
		}
		void push_back(val: T) {
			var node: *ListNode=*LinkedList::ListNode(malloc(sizeof(ListNode)));
			if(node != 0) {
				node.value=val;
				node.next=0;
				node.prev=this.tail;
				if(this.tail != 0) {
					this.tail.next=node;
				}
				this.tail=node;
				if(this.head == 0) {
					this.head=node;
				}
				this.sz=this.sz+1;
			}
		}
		void pop_front() {
			if(this.head != 0) {
				var node: *ListNode=this.head;
				this.head=this.head.next;
				if(this.head != 0) {
					this.head.prev=0;
				} else {
					this.tail=0;
				}
				free(node);
				this.sz=this.sz-1;
			}
		}
		void pop_back() {
			if(this.tail != 0) {
				var node: *ListNode=this.tail;
				this.tail=this.tail.prev;
				if(this.tail != 0) {
					this.tail.next=0;
				} else {
					this.head=0;
				}
				free(node);
				this.sz=this.sz-1;
			}
		}
		T front() {
			var result: T;
			if(this.head != 0) {
				result=this.head.value;
			}
			return result;
		}
		T back() {
			var result: T;
			if(this.tail != 0) {
				result=this.tail.value;
			}
			return result;
		}
		u64 size() {
			return this.sz;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			for(; this.head != 0; ) {
				this.pop_front();
			}
		}
	private:
		class ListNode {
		public:
			ListNode() {}
			value: T;
			next: *ListNode;
			prev: *ListNode;
		};
		head: *ListNode;
		tail: *ListNode;
		sz: u64;
	};

	# ============================================================
	# Stack
	# ============================================================
	template$T:typename$
	class Stack {
	public:
		Stack() {
			this.buffer=0;
			this.sz=0;
			this.cap=0;
		}
		~Stack() {
			if(this.buffer != 0) {
				free(this.buffer);
			}
		}
		void push(val: T) {
			if(this.sz >= this.cap) {
				var new_cap: u64=this.cap;
				if(new_cap == 0) {
					new_cap=4;
				} else {
					new_cap=new_cap * 2;
				}
				var new_buf: *char=malloc(new_cap * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						memcpy(new_buf,this.buffer,this.sz * sizeof(T));
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.cap=new_cap;
				}
			}
			if(this.buffer != 0) {
				memcpy(this.buffer+this.sz * sizeof(T),&val,sizeof(T));
				this.sz=this.sz+1;
			}
		}
		void pop() {
			if(this.sz > 0) {
				this.sz=this.sz-1;
			}
		}
		T top() {
			var result: T;
			if(this.sz > 0 && this.buffer != 0) {
				memcpy(&result,this.buffer+(this.sz-1) * sizeof(T),sizeof(T));
			}
			return result;
		}
		u64 size() {
			return this.sz;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
	private:
		buffer: *char;
		sz: u64;
		cap: u64;
	};

	# ============================================================
	# queue
	# ============================================================
	template$T:typename$
	class queue {
	public:
		queue() {
			this.buffer=0;
			this.head=0;
			this.tail=0;
			this.cap=0;
		}
		~queue() {
			if(this.buffer != 0) {
				free(this.buffer);
			}
		}
		void push(val: T) {
			if(this.tail-this.head >= this.cap) {
				var new_cap: u64=this.cap;
				if(new_cap == 0) {
					new_cap=8;
				} else {
					new_cap=new_cap * 2;
				}
				var new_buf: *char=malloc(new_cap * sizeof(T));
				if(new_buf != 0) {
					var i: u64=0;
					for(i=0; i < this.tail-this.head; i=i+1) {
						memcpy(new_buf+i * sizeof(T),
							this.buffer+(this.head+i) * sizeof(T),
							sizeof(T));
					}
					if(this.buffer != 0) {
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.tail=this.tail-this.head;
					this.head=0;
					this.cap=new_cap;
				}
			}
			if(this.buffer != 0) {
				memcpy(this.buffer+this.tail * sizeof(T),&val,sizeof(T));
				this.tail=this.tail+1;
			}
		}
		void pop() {
			if(this.head < this.tail) {
				this.head=this.head+1;
			}
		}
		T front() {
			var result: T;
			if(this.head < this.tail && this.buffer != 0) {
				memcpy(&result,this.buffer+this.head * sizeof(T),sizeof(T));
			}
			return result;
		}
		T back() {
			var result: T;
			if(this.head < this.tail && this.buffer != 0) {
				memcpy(&result,this.buffer+(this.tail-1) * sizeof(T),sizeof(T));
			}
			return result;
		}
		u64 size() {
			return this.tail-this.head;
		}
		i32 empty() {
			if(this.head >= this.tail) {
				return 1;
			}
			return 0;
		}
	private:
		buffer: *char;
		head: u64;
		tail: u64;
		cap: u64;
	};

	# ============================================================
	# Map (simple hash map with chaining)
	# ============================================================
	template$K:typename,V:typename$
	class Map {
	public:
		Map() {
			this.keys=0;
			this.values=0;
			this.sz=0;
			this.cap=0;
		}
		~Map() {
			if(this.keys != 0) {
				free(this.keys);
			}
			if(this.values != 0) {
				free(this.values);
			}
		}
		void insert(key: K,val: V) {
			if(this.sz >= this.cap) {
				var new_cap: u64=this.cap;
				if(new_cap == 0) {
					new_cap=8;
				} else {
					new_cap=new_cap * 2;
				}
				var new_keys: *char=malloc(new_cap * sizeof(K));
				var new_vals: *char=malloc(new_cap * sizeof(V));
				if(new_keys != 0 && new_vals != 0) {
					if(this.keys != 0) {
						memcpy(new_keys,this.keys,this.sz * sizeof(K));
						free(this.keys);
					}
					if(this.values != 0) {
						memcpy(new_vals,this.values,this.sz * sizeof(V));
						free(this.values);
					}
					this.keys=new_keys;
					this.values=new_vals;
					this.cap=new_cap;
				}
			}
			if(this.keys != 0 && this.values != 0) {
				memcpy(this.keys+this.sz * sizeof(K),&key,sizeof(K));
				memcpy(this.values+this.sz * sizeof(V),&val,sizeof(V));
				this.sz=this.sz+1;
			}
		}
		V get(key: K) {
			var result: V;
			var i: u64=0;
			for(i=0; i < this.sz; i=i+1) {
				var k: K;
				memcpy(&k,this.keys+i * sizeof(K),sizeof(K));
				if(k == key) {
					memcpy(&result,this.values+i * sizeof(V),sizeof(V));
					return result;
				}
			}
			return result;
		}
		i32 contains(key: K) {
			var i: u64=0;
			for(i=0; i < this.sz; i=i+1) {
				var k: K;
				memcpy(&k,this.keys+i * sizeof(K),sizeof(K));
				if(k == key) {
					return 1;
				}
			}
			return 0;
		}
		void remove(key: K) {
			var i: u64=0;
			for(i=0; i < this.sz; i=i+1) {
				var k: K;
				memcpy(&k,this.keys+i * sizeof(K),sizeof(K));
				if(k == key) {
					var j: u64=i;
					for(j=i; j < this.sz-1; j=j+1) {
						memcpy(this.keys+j * sizeof(K),
							this.keys+(j+1) * sizeof(K),
							sizeof(K));
						memcpy(this.values+j * sizeof(V),
							this.values+(j+1) * sizeof(V),
							sizeof(V));
					}
					this.sz=this.sz-1;
					return;
				}
			}
		}
		u64 size() {
			return this.sz;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			this.sz=0;
		}
	private:
		keys: *char;
		values: *char;
		sz: u64;
		cap: u64;
	};

	# ============================================================
	# Set
	# ============================================================
	template$T:typename$
	class Set {
	public:
		Set() {
			this.buffer=0;
			this.sz=0;
			this.cap=0;
		}
		~Set() {
			if(this.buffer != 0) {
				free(this.buffer);
			}
		}
		void insert(val: T) {
			if(this.contains(val)) {
				return;
			}
			if(this.sz >= this.cap) {
				var new_cap: u64=this.cap;
				if(new_cap == 0) {
					new_cap=8;
				} else {
					new_cap=new_cap * 2;
				}
				var new_buf: *char=malloc(new_cap * sizeof(T));
				if(new_buf != 0) {
					if(this.buffer != 0) {
						memcpy(new_buf,this.buffer,this.sz * sizeof(T));
						free(this.buffer);
					}
					this.buffer=new_buf;
					this.cap=new_cap;
				}
			}
			if(this.buffer != 0) {
				memcpy(this.buffer+this.sz * sizeof(T),&val,sizeof(T));
				this.sz=this.sz+1;
			}
		}
		i32 contains(val: T) {
			var i: u64=0;
			for(i=0; i < this.sz; i=i+1) {
				var v: T;
				memcpy(&v,this.buffer+i * sizeof(T),sizeof(T));
				if(v == val) {
					return 1;
				}
			}
			return 0;
		}
		void remove(val: T) {
			var i: u64=0;
			for(i=0; i < this.sz; i=i+1) {
				var v: T;
				memcpy(&v,this.buffer+i * sizeof(T),sizeof(T));
				if(v == val) {
					var j: u64=i;
					for(j=i; j < this.sz-1; j=j+1) {
						memcpy(this.buffer+j * sizeof(T),
							this.buffer+(j+1) * sizeof(T),
							sizeof(T));
					}
					this.sz=this.sz-1;
					return;
				}
			}
		}
		u64 size() {
			return this.sz;
		}
		i32 empty() {
			if(this.sz == 0) {
				return 1;
			}
			return 0;
		}
		void clear() {
			this.sz=0;
		}
	private:
		buffer: *char;
		sz: u64;
		cap: u64;
	};

	# ============================================================
	# Smart Pointer (RefCounted)
	# ============================================================
	template$T:typename$
	class SharedPtr {
	public:
		SharedPtr() {
			this.ptr=0;
			this.ref_count=0;
		}
		SharedPtr(val: T) {
			this.ptr=*T(malloc(sizeof(T)));
			this.ref_count=*u64(malloc(sizeof(u64)));
			if(this.ptr != 0 && this.ref_count != 0) {
				memcpy(this.ptr,&val,sizeof(T));
				memcpy(this.ref_count,&1,sizeof(u64));
			}
		}
		SharedPtr(other: SharedPtr) {
			this.ptr=other.ptr;
			this.ref_count=other.ref_count;
			if(this.ref_count != 0) {
				var count: u64=0;
				memcpy(&count,this.ref_count,sizeof(u64));
				count=count+1;
				memcpy(this.ref_count,&count,sizeof(u64));
			}
		}
		~SharedPtr() {
			if(this.ref_count != 0) {
				var count: u64=0;
				memcpy(&count,this.ref_count,sizeof(u64));
				if(count <= 1) {
					if(this.ptr != 0) {
						free(this.ptr);
					}
					free(this.ref_count);
				} else {
					count=count-1;
					memcpy(this.ref_count,&count,sizeof(u64));
				}
			}
		}
		T get() {
			var result: T;
			if(this.ptr != 0) {
				memcpy(&result,this.ptr,sizeof(T));
			}
			return result;
		}
		u64 use_count() {
			var count: u64=0;
			if(this.ref_count != 0) {
				memcpy(&count,this.ref_count,sizeof(u64));
			}
			return count;
		}
		i32 unique() {
			if(this.use_count() == 1) {
				return 1;
			}
			return 0;
		}
	private:
		ptr: *T;
		ref_count: *u64;
	};

	# ============================================================
	# Function wrapper (simple callback)
	# ============================================================
	template$T:typename,R:typename$
	class Function {
	public:
		Function() {
			this.func_ptr=0;
		}
		Function(f: T) {
			this.func_ptr=f;
		}
		R call(arg: T) {
			var result: R;
			return result;
		}
	private:
		func_ptr: T;
	};

	# ============================================================
	# Range (for iteration)
	# ============================================================
	class Range {
	public:
		Range(start: i64,end: i64,step: i64) {
			this.start=start;
			this.end=end;
			this.step=step;
			this.current=start;
		}
		Range(start: i64,end: i64) {
			this.start=start;
			this.end=end;
			this.step=1;
			this.current=start;
		}
		Range(end: i64) {
			this.start=0;
			this.end=end;
			this.step=1;
			this.current=0;
		}
		i32 has_next() {
			if(this.step > 0) {
				if(this.current < this.end) {
					return 1;
				}
			} else {
				if(this.current > this.end) {
					return 1;
				}
			}
			return 0;
		}
		i64 next() {
			var val: i64=this.current;
			this.current=this.current+this.step;
			return val;
		}
		void reset() {
			this.current=this.start;
		}
	private:
		start: i64;
		end: i64;
		step: i64;
		current: i64;
	};

	# ============================================================
	# Bitset
	# ============================================================
	class Bitset {
	public:
		Bitset(n: u64) {
			this.num_bits=n;
			var num_bytes: u64=(n+7)/8;
			this.data=malloc(num_bytes);
			if(this.data != 0) {
				var i: u64=0;
				for(i=0; i < num_bytes; i=i+1) {
					this.data[i]=0;
				}
			}
		}
		~Bitset() {
			if(this.data != 0) {
				free(this.data);
			}
		}
		void set(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx/8;
				var bit_idx: u64=idx % 8;
				this.data[byte_idx]=this.data[byte_idx] | (1 << bit_idx);
			}
		}
		void reset(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx/8;
				var bit_idx: u64=idx % 8;
				this.data[byte_idx]=this.data[byte_idx] & ~(1 << bit_idx);
			}
		}
		void flip(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx/8;
				var bit_idx: u64=idx % 8;
				this.data[byte_idx]=this.data[byte_idx] ^ (1 << bit_idx);
			}
		}
		i32 test(idx: u64) {
			if(idx < this.num_bits && this.data != 0) {
				var byte_idx: u64=idx/8;
				var bit_idx: u64=idx % 8;
				if(this.data[byte_idx] & (1 << bit_idx)) {
					return 1;
				}
			}
			return 0;
		}
		u64 size() {
			return this.num_bits;
		}
		i32 all() {
			if(this.data == 0) {
				return 0;
			}
			var num_bytes: u64=(this.num_bits+7)/8;
			var i: u64=0;
			for(i=0; i < num_bytes; i=i+1) {
				if(this.data[i] != 0xFF) {
					return 0;
				}
			}
			return 1;
		}
		i32 any() {
			if(this.data == 0) {
				return 0;
			}
			var num_bytes: u64=(this.num_bits+7)/8;
			var i: u64=0;
			for(i=0; i < num_bytes; i=i+1) {
				if(this.data[i] != 0) {
					return 1;
				}
			}
			return 0;
		}
		i32 none() {
			return !this.any();
		}
		void clear() {
			if(this.data != 0) {
				var num_bytes: u64=(this.num_bits+7)/8;
				var i: u64=0;
				for(i=0; i < num_bytes; i=i+1) {
					this.data[i]=0;
				}
			}
		}
	private:
		data: *char;
		num_bits: u64;
	};

	# ============================================================
	# Time utilities
	# ============================================================
	extern i64 clock();
	extern i64 time();
	extern void sleep_ms(ms: u64);

	# ============================================================
	# Type traits
	# ============================================================
	template$T:typename$
	i32 is_signed() {
		var x: T=0;
		if(x-1 < x) {
			return 1;
		}
		return 0;
	}
	template$T:typename$
	i32 is_unsigned() {
		return !is_signed(T);
	}

	# ============================================================
	# Move semantics (simulated)
	# ============================================================
	template$T:typename$
	T move(val: T) {
		return val;
	}

	# ============================================================
	# Forward
	# ============================================================
	template$T:typename$
	T forward(val: T) {
		return val;
	}
}
